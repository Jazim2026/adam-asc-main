<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_request_wizard_form" model="ir.ui.view">
        <field name="name">document.request.wizard.form</field>
        <field name="model">document.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Document Request">
                <group>
                    <field name="message" widget="html"/>
                </group>
                <footer>
                    <button name="action_send" string="Send" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
