<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Template For Case registration in Portal View-->
    <template id="portal_my_home_legal_case" name="Legal Cases"
              customize_show="True" inherit_id="portal.portal_my_home">

        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <div class="mt-3">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/legal_case_management/static/img/case.png'"/>
                    <t t-set="title">Legal Case</t>
                    <t t-set="text">Follow your Case Details</t>
                    <t t-set="url" t-value="'/my/legal/case'"/>
                    <t t-set="placeholder_count" t-value="'case_count'"/>
                </t>
            </div>
        </xpath>

    </template>
    <template id="portal_my_legal_case_requests"
              name="Portal My Case Details">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Cases</t>
            </t>
            <t t-if="request.env.user.partner_id.is_agent">
                <div>
                    <span>Agent Code:
                        <strong>
                            <t t-esc="request.env.user.partner_id.agent_code"/>
                        </strong>
                    </span>
                    <span style="margin: 0 15px;">|</span>
                    <span>Agent Name:
                        <strong>
                            <t t-esc="request.env.user.partner_id.name"/>
                        </strong>
                    </span>
                    <span style="margin: 0 15px;">|</span>
                    <span>Total Cases:
                        <strong>
                            <t t-esc="request.env.user.partner_id.agent_case_count"/>
                        </strong>
                    </span>
                </div>
            </t>
            <br/>
            <br/>
            <t t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Case #</th>
                        <th>Date</th>
                        <th class='d-none d-md-table-cell'>Details</th>
                        <th>Document</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="records" t-as="case">
                        <tr>
                            <td>
                                <a t-attf-href="/my/cases/#{case.id}?{{ keep_query() }}"
                                   t-att-title="case.name">
                                    <t t-esc="case.name"/>
                                </a>
                            </td>
                            <td>
                                <t t-esc="case.register_date"/>
                            </td>
                            <td>
                                <t t-esc="case.description"/>
                            </td>
                            <!-- Document Column -->
                            <td>
                                <t t-set="attachments" t-value="request.env['ir.attachment'].sudo().search([
                                    ('res_id', '=', case.id),
                                    ('res_model', '=', 'case.registration')
                                ])"/>
                                <t t-foreach="attachments" t-as="attachment">
                                    <a t-attf-href="/web/content/#{attachment.id}?download=true"
                                       t-att-title="attachment.name">
                                        <i class="fa fa-paperclip"/>
                                        <t t-esc="attachment.name"/>
                                    </a>
                                    <br/>
                                </t>
                                <t t-if="not attachments">
                                    <span class="text-muted">No documents</span>
                                </t>
                            </td>
                            <!-- Status Column -->
                            <td>
                                <t t-if="case.state=='draft'">
                                    <span class="badge rounded-pill text-bg-info">
                                        <i class="fa fa-fw fa-clock-o"
                                           aria-label="Opened" title="Opened"
                                           role="img"/>
                                        <span class="d-none d-md-inline">Draft</span>
                                    </span>
                                </t>
                                <t t-if="case.state=='in_progress'">
                                    <span class="badge rounded-pill text-bg-success">
                                        <i class="fa fa-fw fa-check"
                                           aria-label="In Progress" title="In Progress"
                                           role="img"/>
                                        <span class="d-none d-md-inline">In Progress</span>
                                    </span>
                                </t>
                                <t t-if="case.state=='invoiced'">
                                    <span class="badge rounded-pill text-bg-success">
                                        <i class="fa fa-fw fa-check"
                                           aria-label="Invoiced" title="Invoiced"
                                           role="img"/>
                                        <span class="d-none d-md-inline">Invoiced</span>
                                    </span>
                                </t>
                                <t t-if="case.state=='reject'">
                                    <span class="badge rounded-pill text-bg-danger">
                                        <i class="fa fa-fw fa-times"
                                           aria-label="Rejected" title="Rejected"
                                           role="img"/>
                                        <span class="d-none d-md-inline">Rejected</span>
                                    </span>
                                </t>
                                <t t-if="case.state=='won'">
                                    <span class="badge rounded-pill text-bg-success">
                                        <i class="fa fa-fw fa-trophy"
                                           aria-label="Won" title="Won"
                                           role="img"/>
                                        <span class="d-none d-md-inline">Won</span>
                                    </span>
                                </t>
                                <t t-if="case.state=='lost'">
                                    <span class="badge rounded-pill text-bg-danger">
                                        <i class="fa fa-fw fa-times"
                                           aria-label="Lost" title="Lost"
                                           role="img"/>
                                        <span class="d-none d-md-inline">Lost</span>
                                    </span>
                                </t>
                                <t t-if="case.state=='cancel'">
                                    <span class="badge rounded-pill text-bg-warning">
                                        <i class="fa fa-fw fa-remove"
                                           aria-label="Cancelled" title="Cancelled"
                                           role="img"/>
                                        <span class="d-none d-md-inline">Cancelled</span>
                                    </span>
                                </t>
                                <t t-if="case.state=='out_of_court_settlement'">
                                    <span class="badge rounded-pill text-bg-info">
                                        <i class="fa fa-fw fa-handshake-o"
                                           aria-label="Out of Court" title="Out of Court"
                                           role="img"/>
                                        <span class="d-none d-md-inline">Out of Court</span>
                                    </span>
                                </t>
                                <t t-if="case.state=='contract_finished'">
                                    <span class="badge rounded-pill text-bg-secondary">
                                        <i class="fa fa-fw fa-check-circle"
                                           aria-label="Contract Finished" title="Contract Finished"
                                           role="img"/>
                                        <span class="d-none d-md-inline">Contract Finished</span>
                                    </span>
                                </t>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>
    <template id="portal_my_home_menu_legal_case"
              name="Portal layout : Legal menu entries"
              inherit_id="portal.portal_breadcrumbs">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'case'" class="breadcrumb-item">
                <a t-attf-href="/my/legal/case?{{ keep_query() }}">Legal Cases</a>
            </li>
        </xpath>
    </template>
</odoo>