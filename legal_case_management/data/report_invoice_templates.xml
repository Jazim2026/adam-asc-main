<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document" inherit_id="account.report_invoice_document">
        <xpath expr="//div[hasclass('page')]" position="before">
            <div class="row watermark" t-if="o.payment_state != 'paid' and report_type == 'pdf'"
                 style="position: absolute; margin-top:120px; transform: translate(-50%, -50%) rotate(-45deg); width: 100%; text-align: center; z-index: 100; transform-origin: center;">
                <div class="col-12" name="watermark" style="position: relative;">
                    <span style="-webkit-transform:rotate(-45deg); color:coral; font-size:6em; text-align:center; position:absolute; opacity:0.2;">
                        UNPAID INVOICE
                    </span>
                </div>
            </div>
        </xpath>
    </template>
</odoo>