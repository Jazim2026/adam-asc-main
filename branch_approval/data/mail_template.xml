<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="branch_documents_expiry_reminder" model="mail.template">
        <field name="name">Documents: Expiry Reminder Mail</field>
        <field name="email_from">{{user.email}}</field>
        <field name="model_id" ref="branch_approval.model_res_company"/>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <div>
                <p>
                    Hi
                    <t t-out="object.branch_manager_id.name"/>,<br/><br/>
                    This is a reminder to inform you that validity of your <br/>
                    <t t-if="ctx.get('gst')">GST ,</t> <t t-if="ctx.get('pan')">PAN ,</t> <t t-if="ctx.get('it')">IT Card ,</t>
                    under <t t-out="object.name"/> will expire soon.
                </p>
            </div>
        </field>
    </record>
    <record id="branch_documents_expired" model="mail.template">
        <field name="name">Documents Expired</field>
        <field name="email_from">{{user.email}}</field>
        <field name="model_id" ref="branch_approval.model_res_company"/>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <div>
                <p>
                    Hi
                    <t t-out="object.branch_manager_id.name"/>,<br/><br/>
                    This is  to inform you that validity of your <br/>
                    <t t-if="ctx.get('gst')">GST ,</t> <t t-if="ctx.get('pan')">PAN ,</t> <t t-if="ctx.get('it')">IT Card ,</t>
                    under <t t-out="object.name"/> is expired.
                </p>
            </div>
        </field>
    </record>
</odoo>