<odoo>
    <!-- Form View Definition for branch.approval -->
    <record id="view_form_branch_approval_custom" model="ir.ui.view">
        <field name="name">branch.approval.form.custom</field>
        <field name="model">branch.approval</field>
        <field name="arch" type="xml">
            <form string="Branch Request">
                <header>
                        <button name="action_approve_request"
                                string="Approve" type="object"
                                class="btn btn-primary" invisible="state in ('approve','reject')"/>
                        <button name="action_reject_request"
                                string="Reject" type="object"
                                class="btn btn-secondary" invisible="state in ('approve','reject')"/>
                        <field name="state" widget="statusbar" statusbar_visible="pending,approve"
                        />
                </header>
                <sheet>
                    <!-- Main Form Body -->
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Company Name"/>
                        <h1>
                            <field name="name" required="1"/>
                        </h1>
                    </div>

                    <!-- Tabs for Information -->
                    <notebook>
                        <page string="General Information">
                            <group>
                                <group>
                                    <label for="street" string="Address"/>
                                    <div class="o_address_format">
                                        <field name="street" placeholder="Street..." class="o_address_street" />
                                        <field name="street2" placeholder="Street 2..." class="o_address_street" />
                                        <field name="city" placeholder="City" class="o_address_city" />
                                        <field name="state_id" class="o_address_state" placeholder="State" options="{&quot;no_open&quot;: True}" on_change="1" can_create="True" can_write="True" />
                                        <field name="zip" placeholder="ZIP" class="o_address_zip" />
                                        <field name="country_id" placeholder="Country" class="o_address_country" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}" on_change="1" can_create="True" can_write="True" />
                                    </div>
                                    <field name="vat"/>
                                    <field name="company_registry"/>
                                    <field name="website"/>
                                    <field name="email"/>
                                </group>
                                <group>
                                    <field name="phone"/>
                                    <field name="mobile"/>
                                    <field name="parent_id" readonly="state == 'approve' "/>
                                    <field name="branch_manager_id" readonly="1"/>
                                </group>
                                <group string="Documents &amp; Expiry" name="documents_and_expiry">
                                    <field name="pan_id"/>
                                    <field name="pan_copy"/>
                                    <field name="pan_expiry"/>
                                    <field name="gst_id"/>
                                    <field name="gst_copy"/>
                                    <field name="gst_expiry"/>
                                    <field name="it_card"/>
                                    <field name="it_copy"/>
                                    <field name="it_expiry"/>
                                </group>
                                <group string="Shop Images" name="shop_images">
                                    <field name="attachment_ids" widget="many2many_binary"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <!-- Tree View Definition for branch.approval -->
    <record id="view_tree_branch_approval_custom" model="ir.ui.view">
        <field name="name">branch.approval.tree.custom</field>
        <field name="model">branch.approval</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" required="1"/>
                <field name="branch_manager_id" required="1"/>
                <field name="parent_id" readonly="state == 'approve' "/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record model="ir.actions.act_window" id="company_branch_request_action">
        <field name="name">Company Branches</field>
        <field name="res_model">branch.approval</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
