<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_company_form" model="ir.ui.view">
        <field name="name">
            view.company.form.inherit.branch.approval
        </field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <field name="company_registry" position="after">
                <field name="branch_manager_id" readonly="1"/>
            </field>
            <group name="social_media" position="after">
                <group string="Documents &amp; Expiry" name="documents_and_expiry">
                    <field name="pan_id"/>
                    <field name="pan_copy"/>
                    <field name="pan_expiry"/>
                    <field name="gst_id"/>
                    <field name="gst_copy"/>
                    <field name="gst_expiry"/>
                    <field name="it_card"/>
                    <field name="it_copy"/>
                    <field name="it_expiry"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
