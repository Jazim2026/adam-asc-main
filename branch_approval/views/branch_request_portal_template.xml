<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Template for portal document -->
    <template id="portal_my_home_field_service" name="Show Branch Requests"
              customize_show="True" inherit_id="portal.portal_my_home" priority="32">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry" >
                <t t-set="icon" t-value="'/branch_approval/static/src/img/company-.svg'"/>
                <t t-set="title">Branch Approval Request</t>
                <t t-set="url" t-value="'/company/branch/request/data'"/>
                <t t-set="text">Follow or view your branch requests</t>
                <t t-set="placeholder_count" t-value="'br_req_count'"/>
            </t>
        </div>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry" >
                <t t-set="icon" t-value="'/branch_approval/static/src/img/folder-open-svgrepo-com.svg'"/>
                <t t-set="title">Branch Expiry Renewal</t>
                <t t-set="url" t-value="'/company/branch/renewal/data'"/>
                <t t-set="text">Follow or view your non active branches</t>
                <t t-set="placeholder_count" t-value="'br_req_renew_count'"/>
            </t>
        </div>
    </template>
</odoo>
